#!/bin/bash
# Mycelium applevf provisioning: runs as root during the first boot, before
# any sandbox code. Generated by internal/sandbox/applevf; the templated values
# are integers, booleans and fixed names only. It holds no secret: the proxy
# credential arrives later on the stdin of the configure step.
set -eu -o pipefail
export DEBIAN_FRONTEND=noninteractive
MYCEL_USER={{.User}}
MYCEL_UID={{.UID}}
MYCEL_PROXY_PORT={{.ProxyPort}}
MYCEL_MAX_PROCS={{.MaxProcs}}
MYCEL_DOCKER={{if .Docker}}1{{else}}0{{end}}

# 1. Packages. This is the only phase with unfiltered network access; it runs
#    before any sandbox code and installs fixed package names from the
#    distribution's signed repository: nft for the firewall, curl as the
#    minimum proxy client and, for docker-nested, rootless Docker.
need=()
command -v nft >/dev/null 2>&1 || need+=(nftables)
command -v curl >/dev/null 2>&1 || need+=(curl)
[ -e /etc/ssl/certs/ca-certificates.crt ] || need+=(ca-certificates)
if [ "$MYCEL_DOCKER" = 1 ]; then
	need+=(docker.io rootlesskit slirp4netns uidmap dbus-user-session fuse-overlayfs iptables)
fi
if [ "${#need[@]}" -gt 0 ]; then
	apt-get update -q
	apt-get install -y -q --no-install-recommends "${need[@]}"
fi

# 2. Docker (rootless only) or no user namespaces at all.
if [ "$MYCEL_DOCKER" = 1 ]; then
	systemctl disable --now docker.service docker.socket >/dev/null 2>&1 || true
	grep -q "^$MYCEL_USER:" /etc/subuid || echo "$MYCEL_USER:100000:65536" >> /etc/subuid
	grep -q "^$MYCEL_USER:" /etc/subgid || echo "$MYCEL_USER:100000:65536" >> /etc/subgid
	rootless=$(command -v dockerd-rootless.sh || true)
	[ -n "$rootless" ] || rootless=/usr/share/docker.io/contrib/dockerd-rootless.sh
	[ -f "$rootless" ] || { echo "mycel: dockerd-rootless.sh not found" >&2; exit 4; }
	chmod 0755 "$rootless"
	cat > /etc/systemd/user/mycel-docker.service <<UNIT
[Unit]
Description=Mycelium rootless Docker

[Service]
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/mycel/docker.env
ExecStart=$rootless --exec-opt native.cgroupdriver=cgroupfs
Restart=always
Type=simple
Delegate=yes
KillMode=mixed

[Install]
WantedBy=default.target
UNIT
else
	{
		echo "user.max_user_namespaces = 0"
		if [ -e /proc/sys/kernel/unprivileged_userns_clone ]; then
			echo "kernel.unprivileged_userns_clone = 0"
		fi
	} > /etc/sysctl.d/90-mycel.conf
	sysctl -q -p /etc/sysctl.d/90-mycel.conf
fi

# 3. Workspace, owned by the default user.
install -d -o "$MYCEL_USER" -g "$(id -gn "$MYCEL_USER")" -m 0755 /workspace

# 4. Process limits: pam_limits for ssh sessions, TasksMax for the user slice
#    (covers sessions, the user manager and rootless Docker).
cat > /etc/security/limits.d/90-mycel.conf <<LIMITS
$MYCEL_USER soft nproc $MYCEL_MAX_PROCS
$MYCEL_USER hard nproc $MYCEL_MAX_PROCS
LIMITS
install -d -m 0755 "/etc/systemd/system/user-$MYCEL_UID.slice.d"
cat > "/etc/systemd/system/user-$MYCEL_UID.slice.d/50-mycel.conf" <<SLICE
[Slice]
TasksMax=$MYCEL_MAX_PROCS
SLICE
systemctl daemon-reload

# 5. Guest helpers (root-owned; the sandbox user can run but not change them)
#    and a login shell that never reads the user's dotfiles, so files the
#    sandbox writes into its home cannot hijack later helper calls.
install -d -m 0755 /usr/local/libexec/mycel
base64 -d > /usr/local/libexec/mycel/helper <<'HELPER'
{{.HelperB64}}
HELPER
chmod 0755 /usr/local/libexec/mycel/helper
base64 -d > /usr/local/libexec/mycel/configure <<'CONFIGURE'
{{.ConfigureB64}}
CONFIGURE
chmod 0700 /usr/local/libexec/mycel/configure
cat > /usr/local/libexec/mycel/shell <<'SHELL'
#!/bin/sh
unset BASH_ENV ENV
exec /bin/bash --noprofile --norc "$@"
SHELL
chmod 0755 /usr/local/libexec/mycel/shell
grep -qx /usr/local/libexec/mycel/shell /etc/shells || echo /usr/local/libexec/mycel/shell >> /etc/shells
usermod -s /usr/local/libexec/mycel/shell "$MYCEL_USER"
install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/10-mycel.conf <<'SSHD'
PermitUserRC no
PermitUserEnvironment no
AllowAgentForwarding no
X11Forwarding no
SSHD
systemctl reload ssh.service 2>/dev/null || systemctl reload sshd.service 2>/dev/null || true

# 6. Firewall: outbound traffic only to the egress proxy on the host
#    (192.168.5.2 in Lima user-mode networking) and DHCP to the gateway;
#    everything else, DNS and IPv6 included, is rejected. Nothing is forwarded.
install -d -m 0755 /etc/mycel
{
	echo 'table inet mycel {'
	echo '	chain output {'
	echo '		type filter hook output priority 0; policy drop;'
	echo '		oif "lo" accept'
	echo '		ct state established,related accept'
	if [ "$MYCEL_PROXY_PORT" -gt 0 ]; then
		echo "		ip daddr 192.168.5.2 tcp dport $MYCEL_PROXY_PORT accept"
	fi
	echo '		ip daddr { 192.168.5.2, 255.255.255.255 } udp sport 68 udp dport 67 accept'
	echo '		meta l4proto tcp counter reject with tcp reset'
	echo '		counter reject'
	echo '	}'
	echo '	chain forward {'
	echo '		type filter hook forward priority 0; policy drop;'
	echo '	}'
	echo '}'
} > /etc/mycel/firewall.nft
nft delete table inet mycel 2>/dev/null || true
nft -f /etc/mycel/firewall.nft
cat > /etc/systemd/system/mycel-firewall.service <<'UNIT'
[Unit]
Description=Mycelium sandbox egress firewall
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/mycel/firewall.nft

[Install]
WantedBy=sysinit.target
UNIT
systemctl enable mycel-firewall.service >/dev/null 2>&1
echo "mycel: provisioned"
